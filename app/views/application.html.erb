<!DOCTYPE html>
<html>
  <head>
  
    <title>Bookers2</title>

    <meta name="viewport" content="width=device-width,initial-scale=1">

    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>

    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css"
          rel="stylesheet">

    <link rel="stylesheet"
          href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css">

    <%= stylesheet_link_tag "application", "data-turbo-track": "reload" %>
    <%= javascript_importmap_tags %>
  </head>
  
  <body>

  <header class="shadow-sm">
    <nav class="navbar navbar-expand-lg navbar-dark bg-dark">
      <div class="container">
        <%= link_to "Bookers", root_path, class: "navbar-brand text-light" %> 
        
        <div class="collapse navbar-collapse">
          <ul class="navbar-nav ms-auto">

  <% if authenticated? %>

    <li class="nav-item">
      <%= link_to user_path(Current.user), class: "nav-link text-light" do %>
        <i class="fa-solid fa-house"></i> Home
      <% end %>
    </li>

    <li class="nav-item">
      <%= link_to users_path, class: "nav-link text-light" do %>
        <i class="fa-solid fa-users"></i> Users
      <% end %>
    </li>

    <li class="nav-item">
      <%= link_to books_path, class: "nav-link text-light" do %>
        <i class="fa-solid fa-book-open"></i> Books
      <% end %>
    </li>

    <li class="nav-item">
      <%= link_to session_path,
          data: { turbo_method: :delete },
          class: "nav-link text-light" do %>
        <i class="fa-solid fa-right-from-bracket"></i> Log out
      <% end %>
    </li>

  <% else %>

    <li class="nav-item">
      <%= link_to root_path, class: "nav-link text-light" do %>
        <i class="fa-solid fa-house"></i> Home
      <% end %>
    </li>

    <li class="nav-item">
      <%= link_to about_path, class: "nav-link text-light" do %>
        <i class="fa-solid fa-link"></i> About
      <% end %>
    </li>

    <li class="nav-item">
      <%= link_to new_user_path, class: "nav-link text-light" do %>
        <i class="fa-solid fa-user-plus"></i> Sign up
      <% end %>
    </li>

    <li class="nav-item">
      <%= link_to new_session_path, class: "nav-link text-light" do %>
        <i class="fa-solid fa-right-to-bracket"></i> Log in
      <% end %>
    </li>

  <% end %>

</ul>
        </div>
      </div>
    </nav>
  </header>

  <div class="container mt-3">
    <% flash.each do |type, message| %>
      <% alert_class = type.to_s == "notice" ? "alert-success" : "alert-danger" %>

      <div class="alert <%= alert_class %>" role="alert">
        <%= message %>
      </div>
    <% end %>
  </div>

  <%= yield %>

<footer>
  <div class="container mt-5">
    <div class="row">
      <div class="col text-center">
        <p>CopyRight Infratop.inc</p>
      </div>
    </div>
  </div>
</footer>
<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
  </body>
</html> 