
<div class="container">

  <% if @book.errors.any? %>
    <div class="text-danger mt-3">
      <h3><%= @book.errors.count %> errors prohibited this book from being saved:</h3>
      <ul>
        <% @book.errors.full_messages.each do |message| %>
          <li><%= message %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <div class="row">

    <div class="col-md-3">
      <%= render "list", user: Current.user, book: @book %>
    </div>

    <div class="col-md-8 offset-md-1">
      <h2>Books</h2>

      <table class="table table-hover table-inverse">
        <thead>
          <tr>
            <th></th>
            <th>Title</th>
            <th>Opinion</th>
          </tr>
        </thead>

        <tbody>
          <% @books.each do |book| %>
            <tr>

              <td>
                <%= link_to user_path(book.user) do %>
                  <% if book.user.profile_image.attached? %>
                    <%= image_tag book.user.profile_image, size: "80x80" %>
                  <% else %>
                    <div style="width:80px; height:80px; background:#ccc; display:flex; align-items:center; justify-content:center; font-size:10px; color:white;">
                      NO IMAGE
                    </div>
                  <% end %>
                <% end %>
              </td>

              <td>
                <%= link_to book.title, book_path(book) %>
              </td>

              <td>
                <%= book.body %>
              </td>

            </tr>
          <% end %>
        </tbody>
      </table>
    </div>

  </div>
</div>