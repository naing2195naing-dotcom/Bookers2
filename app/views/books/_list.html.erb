<h2>User info</h2>

<% if user.profile_image.attached? %>
  <%= image_tag user.profile_image, size: "80x80" %>
<% else %>
  <div style="width:80px; height:80px; background:#ccc; display:flex; align-items:center; justify-content:center; font-size:10px; color:white;">
    NO IMAGE
  </div>
<% end %>

<table class="table">
  <tbody>
    <tr>
      <th>name</th>
      <th><%= user.name %></th>
    </tr>
    <tr>
      <th>introduction</th>
      <th><%= user.introduction %></th>
    </tr>
  </tbody>
</table>

<div class="row">
  <%= link_to edit_user_path(user),
      class: "btn btn-outline-secondary btn-block w-100" do %>
    <i class="fas fa-user-cog"></i>
  <% end %>
</div>

<h2 class="mt-3">New book</h2>

<%= form_with model: book do |f| %>
  <div class="form-group mb-3">
    <%= f.label :title, "Title" %>
    <%= f.text_field :title, class: "form-control" %>
  </div>

  <div class="form-group mb-3">
    <%= f.label :body, "Opinion" %>
    <%= f.text_area :body, class: "form-control" %>
  </div>

  <div class="form-group">
    <%= f.submit "Create Book", class: "btn btn-success" %>
  </div>
<% end %>