
<div class="container">
  <div class="row">
    <div class="col-md-6 mx-auto">
    
      <% if @user.errors.any? %>
        <div class="text-danger">
          <h3><%= pluralize(@user.errors.count, "error") %> prohibited this user from being saved:</h3>
          <ul>
            <% @user.errors.full_messages.each do |message| %>
              <li><%= message %></li>
            <% end %>
          </ul>
        </div>
      <% end %>

      <h2>User info</h2>

      <%= form_with model: @user do |f| %>

        <div class="form-group mb-3">
          <%= f.label :name, "Name" %>
          <%= f.text_field :name, class: "form-control" %>
        </div>

        <div class="form-group mb-3">
          <%= f.label :profile_image, "Image" %>
          <%= f.file_field :profile_image, class: "form-control" %>
        </div>

        <div class="form-group mb-3">
          <%= f.label :introduction, "Introduction" %>
          <%= f.text_area :introduction, class: "form-control" %>
        </div>

        <div class="form-group">
          <%= f.submit "Update User", class: "btn btn-secondary" %>
        </div>

      <% end %>
        <%= link_to "Show", user_path(@user) %>
    </div>
  </div>
</div>
