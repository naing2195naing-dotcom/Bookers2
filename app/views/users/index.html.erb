<div class="container px-5 px-sm-0">
  <div class="row">

    <div class="col-md-3">
      <%= render "books/list", user: Current.user, book: @book %>
    </div>

  <div class="col-md-8 offset-md-1">
  <h2>Users</h2>

  <table class="table table-hover">
    <thead>
      <tr>
        <th>Image</th>
        <th>Name</th>
        <th></th>
      </tr>
    </thead>

    <tbody>
      <% @users.each do |user| %>
        <tr>
          <td>
            <% if user.profile_image.attached? %>
              <%= image_tag user.profile_image, size: "80x80" %>
            <% else %>
              <div style="width:80px; height:80px; background:#ccc; display:flex; align-items:center; justify-content:center; font-size:10px; color:white;">
                NO IMAGE
              </div>
            <% end %>
          </td>

          <td><%= user.name %></td>

          <td>
            <%= link_to "Show", user_path(user) %>
          </td>
        </tr>
      <% end %>
    </tbody>
  </table>
</div>

  </div>
</div>